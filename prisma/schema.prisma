// Cadence data model. Twenty CRM stays the system of record; Cadence stores
// sequencing state, a read cache of people, and an audit trail of every change.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  SALES_LEADER
  POD_MANAGER
  SENIOR_FO
  JUNIOR_FO
  BIZ_OPS
}

enum ActionType {
  EMAIL
  CALL
  LINKEDIN_CONNECT
  LINKEDIN_MESSAGE
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  REPLIED
  MEETING
  COMPLETED
  EXITED
}

enum TaskState {
  PENDING
  DONE
  SKIPPED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  ACTIVE
  PAUSED
  STOPPED
  COMPLETED
}

enum CampaignAudience {
  CRM
  SANDBOX
}

enum CampaignSource {
  IDS
  CSV
  TWENTY_VIEW
}

enum AssignmentMode {
  OWNER
  ROUND_ROBIN
}

enum CompletionSource {
  OBSERVED_MESSAGE
  OBSERVED_NOTE
  OBSERVED_TWENTY_TASK
  MANUAL
  SYSTEM
}

enum EventSource {
  WEBHOOK
  RECONCILE
  MANUAL
}

enum ActorType {
  USER
  WEBHOOK
  SYSTEM
  RECONCILE
}

enum TouchDirection {
  OUTBOUND
  INBOUND
}

enum Channel {
  EMAIL
  CALL
  LINKEDIN
  /// A meeting Twenty told us about (an opportunity booked against a contact). Not a touch
  /// anybody performed, which is why it is its own channel rather than filed as a call.
  MEETING
}

/// Where a recording lives. Only some providers allow embedding in an iframe.
enum MeetingProvider {
  TEAMS
  ZOOM
  GOOGLE_MEET
  SHAREPOINT
  DRIVE
  FILE
  OTHER
}

enum AnalysisStatus {
  NONE
  PENDING
  READY
  FAILED
}

// ---------------------------------------------------------------------------
// Users, sessions, pods
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           Role
  /// Twenty workspaceMember id this user maps to (outbound activity is matched on it).
  twentyMemberId String?   @unique
  /// Extra handles that identify this user in note titles, e.g. "tw_alisa".
  aliases        String[]  @default([])
  timezone       String    @default("America/Chicago")
  notificationsReadAt DateTime?
  /// Per-user override of the daily action cap. Null = use the global setting.
  dailyCap       Int?
  active         Boolean   @default(true)
  /// False for someone who joined by signing in with Microsoft: they work as a Junior FO and show
  /// no title until an admin gives them one.
  roleAssigned   Boolean   @default(true)
  /// The Microsoft account (its object id) this user signs in with.
  microsoftId    String?   @unique
  /// The rep's Twilio number (E.164), confirmed by an admin in Settings > Calling from Twilio's
  /// IncomingPhoneNumbers. Imported calls from or to it belong to this rep.
  callerNumber   String?   @unique
  /// When callerNumber was assigned (B165): calls on the line from before then are not this rep's.
  /// Null for assignments made before the release, which count for every call.
  callerNumberSince DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  pods           UserPod[]
  sessions       Session[]
  enrollments    Enrollment[] @relation("EnrollmentFo")
  nextActions    NextAction[] @relation("NextActionFo")
  tasks          Task[]       @relation("TaskFo")
  completedTasks Task[]       @relation("TaskCompletedBy")
  meetings       Meeting[]    @relation("MeetingCreatedBy")
  meetingFavourites MeetingFavourite[]
  blockedAccounts BlockedAccount[] @relation("BlockedByUser")
  enrichmentMarks EnrichmentMark[] @relation("EnrichmentAssignee")
  mipStars        MipStars[]       @relation("MipStarsBy")
  bookedMeetings  Meeting[]        @relation("MeetingBookedBy")
  numberTicketsRaised   MeetingNumberTicket[] @relation("NumberTicketRaisedBy")
  numberTicketsResolved MeetingNumberTicket[] @relation("NumberTicketResolvedBy")
  sandboxContacts SandboxContact[] @relation("SandboxOwner")
  calls           CallLog[]        @relation("CallUser")
  ticketsRaised         Ticket[]              @relation("TicketRaisedBy")
  ticketsResolved       Ticket[]              @relation("TicketResolvedBy")
  notifications         Notification[]        @relation("NotificationFor")
  linkedinFollowUps     LinkedInFollowUp[]    @relation("LinkedInFollowUpFo")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A pod is the set of people whose Twenty `podOwner` equals `podOwnerValue`,
/// worked by one or more FOs (UserPod).
model Pod {
  id            String   @id @default(uuid())
  name          String   @unique
  podOwnerValue String   @unique
  /// Set when Cadence created the pod itself because a person arrived with an unknown podOwner.
  discoveredAt  DateTime?
  archived      Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users       UserPod[]
  campaigns   Campaign[]
  enrollments Enrollment[]
  sandboxContacts SandboxContact[]
  calls           CallLog[]
}

model UserPod {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  podId  String
  pod    Pod    @relation(fields: [podId], references: [id], onDelete: Cascade)

  @@id([userId, podId])
}

// ---------------------------------------------------------------------------
// Sequences
// ---------------------------------------------------------------------------

/// One editable plan per sequence. There are no versions: a step is edited in place, and a step
/// that has open tasks is refused until they are worked, so nothing shifts under a live task.
/// What a task actually says is frozen on the task itself (Task.actionSnapshot), so editing the
/// plan never rewrites work already handed to an FO.
model Sequence {
  id              String   @id @default(uuid())
  name            String
  description     String?
  archived        Boolean  @default(false)
  campaignOwned   Boolean  @default(false)
  /// Nurture: start again this many days after the last step, until the person answers.
  repeatEveryDays Int?
  /// How many calendar days the plan spans; no step may fall after it. Required for new plans.
  durationDays    Int?
  /// SequenceStep[] - see src/lib/sequences/steps.ts for the schema.
  steps           Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaigns   Campaign[]
  enrollments Enrollment[]
}

// ---------------------------------------------------------------------------
// Campaigns and enrollments
// ---------------------------------------------------------------------------

model Campaign {
  id             String         @id @default(uuid())
  name           String
  sequenceId     String
  sequence       Sequence       @relation(fields: [sequenceId], references: [id])
  podId          String
  pod            Pod            @relation(fields: [podId], references: [id])
  sourceType     CampaignSource @default(IDS)
  /// Twenty view id (TWENTY_VIEW) or a free-text description of the source.
  sourceRef      String?
  /// Person ids the campaign was created from (kept for re-enroll and audit).
  personIds      String[]       @default([])
  assignmentMode AssignmentMode @default(OWNER)
  /// YYYY-MM-DD, first start date for enrollments.
  startDate      String
  /// YYYY-MM-DD, the day by which everyone in the campaign has finished the sequence. The planner
  /// derives how many people each FO may start per day from this and the plan's span.
  endDate        String?
  /// New people started per FO per working day: the planner's rate, or a lower one chosen by hand.
  startsPerFoPerDay Int?
  /// At the end date: false lets people mid-sequence finish; true ends what is left.
  hardStopAtEnd  Boolean        @default(false)
  /// Twenty product-interest option values this campaign is for.
  productInterest String[]      @default([])
  status         CampaignStatus @default(DRAFT)
  description    String?
  /// Campaign-owned editor input and the exact calendar accepted at publication.
  plannerDraft   Json?
  publishedPlan  Json?
  followupSourceId String?
  followupSourceRun Int?
  followupWaitDays Int @default(0)
  approvedAt DateTime?
  approvedById String?
  runNumber Int @default(1)
  /// Which table personIds refers to: Twenty people (CRM) or sandbox contacts. Never mixed.
  audience       CampaignAudience @default(CRM)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  enrollments Enrollment[]

  @@index([audience, status])
}

model Enrollment {
  id                String           @id @default(uuid())
  /// Null while the subject is a sandbox contact; set when that contact moves to the CRM.
  personId          String?
  person            PersonCache?     @relation(fields: [personId], references: [id], onDelete: Restrict)
  sandboxContactId  String?
  sandboxContact    SandboxContact?  @relation(fields: [sandboxContactId], references: [id], onDelete: Restrict)
  companyId         String?
  foUserId          String
  fo                User             @relation("EnrollmentFo", fields: [foUserId], references: [id])
  podId             String?
  pod               Pod?             @relation(fields: [podId], references: [id])
  campaignId        String?
  campaignRun       Int @default(1)
  /// Which pass of a repeating (nurture) sequence this is. Each pass is its own enrollment.
  cycle             Int               @default(1)
  campaign          Campaign?        @relation(fields: [campaignId], references: [id])
  sequenceId        String
  sequence          Sequence         @relation(fields: [sequenceId], references: [id])
  /// YYYY-MM-DD in the FO's timezone. Day 1 of the sequence.
  startDate         String
  /// Index of the latest step whose tasks have been generated. -1 = none yet.
  currentStep       Int              @default(-1)
  /// Id of that step. The index alone would drift if the plan were edited; this is what the
  /// next step is resolved from, so an edit above an enrollment cannot skip or repeat a step.
  currentStepId     String?
  /// Accumulated delay (calendar days) applied to not-yet-generated steps (clock mode = shift).
  shiftDays         Int              @default(0)
  /// Immutable campaign calendar; legacy enrollments use the existing scheduling engine.
  scheduleDates     String[]         @default([])
  status            EnrollmentStatus @default(ACTIVE)
  exitReason        String?
  pausedAt          DateTime?
  pauseReason       String?
  repliedAt         DateTime?
  meetingAt         DateTime?
  completedAt       DateTime?
  exitedAt          DateTime?
  /// CRM or cold outreach (SANDBOX), set once when the enrollment is made and never changed, Move
  /// and Undo included: reports count by it, so a move never rewrites the past (PLAN 8.4, B037). Its
  /// tasks take it from here. Null only on rows written before the stamping code; NOT NULL in W14.
  audience         CampaignAudience?
  createdById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tasks Task[]

  @@index([audience, createdAt])
  @@index([personId, status])
  @@index([sandboxContactId, status])
  @@index([foUserId, status])
  @@index([campaignId])
  @@index([companyId])
  @@index([status])
  /// Weekly reply/meeting counts per FO (Home, Reports).
  @@index([foUserId, repliedAt])
  @@index([foUserId, meetingAt])
}

model Task {
  id                String            @id @default(uuid())
  enrollmentId      String
  enrollment        Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  foUserId          String
  fo                User              @relation("TaskFo", fields: [foUserId], references: [id])
  stepIndex         Int
  stepId            String
  stepDay           Int
  actionIndex       Int
  actionId          String
  action            ActionType
  /// The action actually performed (set on completion). Same as `action` today; kept because a
  /// completion is evidence of a specific channel and reports read this rather than the plan.
  chosenAction      ActionType?
  label             String
  /// YYYY-MM-DD in the FO's timezone (after caps/rollover).
  dueDate           String
  /// The same instant as 09:00 local on dueDate, for ordering and display.
  dueAt             DateTime
  /// The date the sequence plan asked for, before caps/rollover.
  plannedDate       String
  /// YYYY-MM-DD the FO snoozed the task to (shown under that date instead of dueDate).
  snoozedTo         String?
  state             TaskState         @default(PENDING)
  completedAt       DateTime?
  completedById     String?
  completedBy       User?             @relation("TaskCompletedBy", fields: [completedById], references: [id])
  completionSource  CompletionSource?
  /// External evidence id (note:<id>, message:<id>, twentyTask:<id>).
  evidenceId        String?
  skipReason        String?
  cancelReason      String?
  /// Call outcome key from settings.rules.callDispositions (calls only).
  disposition       String?
  /// Free-text note entered when completing or skipping (call notes, context).
  note              String?
  draftSubject      String?
  draftHtml         String?
  draftRevision     Int @default(0)
  actionSnapshot    Json?
  /// Twenty Task mirrored while open (setting `mirrorOpenTasks`).
  twentyTaskId      String?
  /// Twenty Note written on completion.
  twentyNoteId      String?
  /// The emails and calls counted for this step: the one that closed it, a second record of it, or
  /// the one behind a Done clicked by hand.
  countedTouches    Touch[]           @relation("TouchCountedFor")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([enrollmentId, stepIndex, actionIndex])
  @@index([foUserId, state, dueDate])
  @@index([state, dueDate])
  @@index([evidenceId])
  @@index([twentyTaskId])
  /// Weekly "done" counts per FO (Home, Reports).
  @@index([foUserId, state, completedAt])
  @@index([state, completedAt])
  /// Task-list ordering inside a scope.
  @@index([foUserId, snoozedTo])
}

// ---------------------------------------------------------------------------
// Twenty read cache and observed activity
// ---------------------------------------------------------------------------

model PersonCache {
  id              String    @id
  firstName       String    @default("")
  lastName        String    @default("")
  /// "lastname firstname" lower-cased for ordering; null when the record has no name, so the
  /// nameless sort last instead of filling the first pages of every list.
  sortName        String?
  email           String?
  /// `email` and `additionalEmails` trimmed and lower-cased (normalizeEmail), for every comparison:
  /// Twenty keeps an address as typed, so "Jane.Doe@Acme.com" never equalled a suppressed
  /// "jane.doe@acme.com" (B011, B073).
  emailNorm            String?
  additionalEmailsNorm String[] @default([])
  phone           String?
  /// `phone` and `additionalPhone` in E.164, for matching calls and pushes (src/lib/sandbox/normalize.ts).
  phoneE164       String?
  additionalPhoneE164 String?
  linkedinUrl     String?
  /// `linkedinUrl` as linkedin.com/in/<slug> (normalizeLinkedin): what LinkedIn activity is matched on.
  linkedinKey     String?
  jobTitle        String?
  companyId       String?
  companyName     String?
  city            String?
  /// Twenty's assignedTo relation: the workspace member who owns this relationship.
  ownerMemberId   String?
  podOwner        String?

  /// Twenty's dnd select. `dnd` is true when it is set or a do-not-contact tag is present.
  dnd             Boolean   @default(false)
  dndReason       String?
  tags            String[]  @default([])

  /// Contact details beyond the primary ones.
  additionalEmails String[] @default([])
  additionalPhone  String?
  xUrl             String?

  /// How the team classifies the person in Twenty.
  leadSource      String[]  @default([])
  leadSourceNotes String?
  tier            String?
  contactType     String[]  @default([])
  listCategory    String?
  previousCadence String?
  pipelineStage   String?
  productInterest String[]  @default([])
  primaryProduct  String?
  /// Campaigns in Twenty (not Cadence campaigns, which live in the Campaign table).
  campaigns       String[]  @default([])
  onCallingList   Boolean   @default(false)
  dealSignalStrength String?
  /// Twenty says the contact detail is missing or wrong (MISSING_EMAIL / MISSING_PHONE tags).
  emailMissing    Boolean   @default(false)
  phoneMissing    Boolean   @default(false)
  /// Set when the person was rotated out to another pod.
  rotatedTo       String?
  rotationChangedAt DateTime?

  /// What the CRM itself says happens next. Cadence never overwrites these.
  nextAction      String?
  nextActionDueDate String?
  nextStep        String?
  nextActionDueDatePoc String?
  lastNote        String?

  /// Last touch as Twenty's own automations record it, independent of Cadence's touches.
  lastCallAt      DateTime?
  lastEmailAt     DateTime?

  /// Links Twenty keeps on the person: a call recording, a join link, a booking reference.
  recordingUrl    String?
  meetingUrl      String?
  bookingId       String?

  createdBySource String?
  createdByName   String?

  /// Cadence-local flags (Twenty is never written): opted out of outreach, bad contact data.
  optedOut        Boolean   @default(false)
  /// When and where the opt-out came from (src/lib/sandbox/opt-out.ts OptOutSource). Only one from
  /// the post-call form (call_form) may be lifted, by an admin or by Biz Ops closing a ticket (D4).
  optedOutAt      DateTime?
  optOutSource    String?
  optOutLiftedAt  DateTime?
  badEmail        Boolean   @default(false)
  badPhone        Boolean   @default(false)
  raw             Json?
  twentyUpdatedAt DateTime?
  deletedAt       DateTime?
  syncedAt        DateTime  @default(now())

  enrollments      Enrollment[]
  nextActions      NextAction[]
  touches          Touch[]
  meetingAttendees MeetingAttendee[]
  numberTickets    MeetingNumberTicket[]
  calls            CallLog[]
  tickets          Ticket[]
  linkedinFollowUps LinkedInFollowUp[]

  @@index([companyId])
  @@index([podOwner])
  @@index([linkedinKey])
  @@index([email])
  @@index([emailNorm])
  @@index([additionalEmailsNorm], type: Gin)
  @@index([phoneE164])
  @@index([additionalPhoneE164])
  @@index([linkedinUrl])
  @@index([lastName, firstName])
  @@index([ownerMemberId])
  @@index([companyId, lastName])
  @@index([sortName])
  @@index([tier])
  @@index([listCategory])
  @@index([nextActionDueDate])
}

model CompanyCache {
  id            String    @id
  name          String
  /// Lower-cased name for ordering; null when Twenty holds no name, so those sort last.
  sortName      String?
  domain        String?
  /// Twenty workspace member that owns the account.
  ownerMemberId String?
  industry      String?
  employees     Int?
  aum           Decimal? @db.Decimal(24, 2)
  city          String?
  linkedinUrl   String?
  raw           Json?
  twentyUpdatedAt DateTime?
  deletedAt     DateTime?
  syncedAt      DateTime  @default(now())

  meetings Meeting[]

  @@index([ownerMemberId])
  @@index([name])
  @@index([sortName])
}

/// An account an admin has taken out of the platform: gone from Accounts, People, search,
/// enrichment and campaign audiences, and refused by enrollment. Nothing is written to Twenty and
/// no cache row is deleted, so removing it from this list puts the account back as it was.
model BlockedAccount {
  companyId   String   @id
  /// Name and domain as they read when it was blocked, so the list needs no cache row to be legible.
  name        String
  domain      String?
  reason      String?
  blockedById String?
  blockedBy   User?    @relation("BlockedByUser", fields: [blockedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Meetings: a recording link, its transcript, and (later) its analysis
// ---------------------------------------------------------------------------

enum MeetingReview {
  PENDING
  APPROVED
  DISMISSED
}

model Meeting {
  id               String          @id @default(uuid())
  title            String
  provider         MeetingProvider @default(OTHER)
  /// The link the user pasted.
  sourceUrl        String
  /// Embeddable URL when the provider allows framing; null means "open in a new tab".
  embedUrl         String?
  /// Direct media file (mp4/webm) when known, played with a <video> element.
  mediaUrl         String?
  occurredAt       DateTime
  durationSec      Int?
  companyId        String?
  company          CompanyCache?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// Kept even when the company is not cached, so the label always renders.
  companyName      String?
  /// Which of the team's products this meeting was about. A meeting can cover more than one.
  products         String[]        @default([])
  notes            String?
  /// Raw transcript as pasted or uploaded (WebVTT, SRT or plain text).
  transcript       String?
  transcriptFormat String?
  /// When Cadence last asked Microsoft for this recording's Teams transcript.
  transcriptTriedAt DateTime?
  /// Which meeting this is with its prospects: the highest of their numbers, so 1 only when
  /// everyone on it is meeting us for the first time. See src/lib/meetings/numbering.ts.
  meetingNumber    Int?
  /// MeetingAnalysis - see src/lib/meetings/analysis.ts. Written by an analyzer, never by hand.
  analysis         Json?
  analysisStatus   AnalysisStatus  @default(NONE)
  analysisModel    String?
  analysisError    String?
  analysedAt       DateTime?
  createdById      String?
  createdBy        User?           @relation("MeetingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// The Twenty calendar event this meeting was made from, when it came from a calendar.
  calendarEventId  String?         @unique
  /// The note in Twenty that records this meeting on its contacts and account (Twenty keeps the record).
  twentyNoteId     String?
  /// The record in Twenty's own Meetings object, once the workspace has one.
  twentyMeetingId  String?
  /// What Cadence last wrote to that record (src/lib/meetings/crm.ts meetingFacts), and when: a
  /// value Twenty holds that differs from it was changed there, and Cadence writes its own again.
  twentySnapshot   Json?
  twentySyncedAt   DateTime?
  /// When someone last edited it by hand: after that only its time follows the calendar.
  editedAt         DateTime?
  /// The FO who booked it: mandatory on a new meeting, set on older ones when someone edits them.
  bookedById String?
  bookedBy User? @relation("MeetingBookedBy", fields: [bookedById], references: [id], onDelete: SetNull)
  /// A meeting from a calendar waits for a pod manager: PENDING until approved, DISMISSED once
  /// removed (kept so the calendar never brings it back). One added by hand is APPROVED.
  review           MeetingReview   @default(APPROVED)
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime        @default(now())
  favourites       MeetingFavourite[]
  updatedAt        DateTime        @updatedAt

  attendees MeetingAttendee[]
  numberTickets MeetingNumberTicket[]
  tickets       Ticket[]

  @@index([occurredAt])
  @@index([companyId, occurredAt])
  @@index([createdById])
  @@index([review, occurredAt])
  @@index([analysisStatus])
  @@index([twentyMeetingId])
}

/// "Think this is wrong?": someone doubts which meeting with a prospect this is, and Biz Ops
/// checks it, sets the number if it is wrong, and closes it. See src/lib/actions/number-checks.ts.
/// It sits beside the general Ticket below, and Biz Ops' Tickets section lists both; its columns map
/// onto a Ticket of kind MEETING_NUMBER (meetingDay, shownNumber, expectedNumber go in `details`),
/// so it can be folded in later without losing anything.
model MeetingNumberTicket {
  id             String       @id @default(uuid())
  personId       String
  person         PersonCache  @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// The meeting it was raised on; null while that meeting was still being added and was never saved.
  meetingId      String?
  meeting        Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  /// The meeting's day as the form had it (YYYY-MM-DD), and the number Cadence showed for it.
  meetingDay     String
  shownNumber    Int
  /// What the person raising it thinks it should be, and what they know.
  expectedNumber Int?
  note           String?
  open           Boolean      @default(true)
  raisedById     String?
  raisedBy       User?        @relation("NumberTicketRaisedBy", fields: [raisedById], references: [id], onDelete: SetNull)
  resolvedById   String?
  resolvedBy     User?        @relation("NumberTicketResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  /// What Biz Ops found, for whoever raised it.
  resolution     String?
  createdAt      DateTime     @default(now())

  @@index([open, createdAt])
  @@index([personId])
}

/// A meeting somebody starred. Personal: each user keeps their own list.
model MeetingFavourite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, meetingId])
  @@index([meetingId])
}

model MeetingAttendee {
  id        String       @id @default(uuid())
  meetingId String
  meeting   Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name      String?
  email     String?
  /// Matched Twenty person, when the address is known.
  personId  String?
  person    PersonCache? @relation(fields: [personId], references: [id], onDelete: SetNull)
  /// Matched Cadence user, when the address is one of ours.
  userId    String?
  /// True when the address is outside settings.rules.internalDomains.
  external  Boolean      @default(false)
  host      Boolean      @default(false)
  /// A prospect from Twenty the meeting was with: not one of the team, not a typed-in guest.
  prospect  Boolean      @default(false)
  /// Which meeting with this prospect it is: their earliest meeting in Cadence is 1.
  meetingNumber Int?
  /// Set by Biz Ops after a number check: this meeting is this number, and later ones count on from it.
  numberSetTo   Int?

  @@unique([meetingId, email])
  @@index([meetingId])
  @@index([personId])
  @@index([personId, prospect])
  @@index([email])
}

/// Every observed or performed touch on a person, across channels.
model Touch {
  id          String         @id @default(uuid())
  /// Null for a touch on a sandbox contact; set when that contact moves to the CRM.
  personId    String?
  person      PersonCache?   @relation(fields: [personId], references: [id], onDelete: Cascade)
  sandboxContactId String?
  sandboxContact   SandboxContact? @relation(fields: [sandboxContactId], references: [id], onDelete: Cascade)
  channel     Channel
  direction   TouchDirection
  occurredAt  DateTime
  summary     String
  /// Unique source reference, e.g. note:<id>, message:<id>, task:<cadenceTaskId>.
  externalId  String         @unique
  actorUserId String?
  actorLabel  String?
  /// The step this email or call counted for, once one has claimed it. A touch counts once.
  countedForTaskId String?
  countedForTask   Task?          @relation("TouchCountedFor", fields: [countedForTaskId], references: [id], onDelete: SetNull)
  /// CRM or cold outreach (SANDBOX), set once when the touch is recorded and never changed (PLAN 8.4,
  /// B037). Null only on rows written before the stamping code; NOT NULL in W14.
  audience         CampaignAudience?
  /// Another record of an email already counted: the CRM's copy of an email to an "Also in CRM" cold
  /// contact, whose cold touch is the one that counts (PLAN 6 rule 2, 8.14). Shown on the person's
  /// timeline, left out of every figure, so All outreach counts the email once.
  copyOfTouchId    String?
  createdAt   DateTime       @default(now())

  @@index([audience, occurredAt])
  @@index([copyOfTouchId])
  @@index([personId, occurredAt])
  @@index([sandboxContactId, occurredAt])
  @@index([countedForTaskId])
  @@index([occurredAt])
  @@index([createdAt])
}

/// Raw inbound events (webhooks, reconcile scans) with dedupe and processing result.
model ActivityEvent {
  id                String      @id @default(uuid())
  source            EventSource
  objectType        String
  eventName         String
  externalId        String
  externalUpdatedAt DateTime?
  /// `${objectType}:${externalId}:${externalUpdatedAt ?? eventName}` - unique so a record
  /// version is processed once.
  dedupeKey         String      @unique
  payload           Json
  receivedAt        DateTime    @default(now())
  processedAt       DateTime?
  result            String?
  needsReview       Boolean     @default(false)
  reviewNote        String?

  @@index([objectType, externalId])
  @@index([needsReview])
  @@index([receivedAt])
}

/// Every write Cadence makes (or would make, in dry run) to Twenty.
model TwentyWrite {
  id            String    @id @default(uuid())
  operation     String
  objectType    String
  twentyId      String?
  taskId        String?
  payload       Json
  dryRun        Boolean   @default(false)
  /// OK once Twenty accepted it; FAILED rows are the outbox the worker retries with backoff.
  status        String    @default("OK")
  error         String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  /// Twenty's updatedAt on the record right after this write, as Twenty wrote it: Undo of a move
  /// tells Cadence's own writes from someone's edit by it (B033).
  resultUpdatedAt String?
  createdAt     DateTime  @default(now())

  @@index([taskId])
  @@index([twentyId])
  @@index([status, nextAttemptAt])
}

model AuditLog {
  id         String    @id @default(uuid())
  entityType String
  entityId   String
  action     String
  actorType  ActorType
  actorId    String?
  actorLabel String?
  details    Json?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  /// The Activity feed: newest first, optionally filtered by person or type.
  @@index([actorId, createdAt])
  @@index([entityType, createdAt])
}

/// N12: CRM requests sent per minute, shared by the web app and the worker (src/lib/twenty/pace.ts).
model CrmRequestBudget {
  minute DateTime @id
  used   Int      @default(0)
}

/// U19, U27, V09: requests per minute for the Bellwether integration and the read API, shared by every process.
model ApiRateHit {
  id     BigInt   @id @default(autoincrement())
  bucket String
  at     DateTime

  @@index([bucket, at])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A note on one missing field of one record: who is researching it, or that it could not be
/// found. "Not found" takes the gap out of the queue while the value is still missing; when a value
/// arrives from Twenty the gap is gone and the mark is history.
/// How much a most-important person matters to the pod: one to three stars, set by the pod itself.
/// Empty until somebody in the pod says; a Cadence judgement, never written back to Twenty.
model MipStars {
  personId    String   @id
  stars       Int
  updatedById String?
  updatedBy   User?    @relation("MipStarsBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

model EnrichmentMark {
  id         String   @id @default(uuid())
  entity     String
  recordId   String
  field      String
  kind       String
  assigneeId String?
  assignee   User?    @relation("EnrichmentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  note       String?
  byId       String?
  createdAt  DateTime @default(now())

  @@unique([entity, recordId, field])
  @@index([assigneeId])
}

/// One field's completeness for one group on one day, written nightly, so the scorecard shows trend.
model EnrichmentSnapshot {
  id        String @id @default(uuid())
  day       String
  entity    String
  groupKind String
  groupId   String
  field     String
  total     Int
  filled    Int

  @@unique([day, entity, groupKind, groupId, field])
  @@index([day])
}

/// The column mapping last used for a file with these headers, so the same export maps itself next time.
model EnrichmentMapping {
  signature String   @id
  entity    String
  mapping   Json
  name      String
  usedAt    DateTime @updatedAt
}

model EnrichmentBatch {
  id String @id @default(uuid())
  entity String
  name String
  createdById String
  createdAt DateTime @default(now())
  rows EnrichmentRow[]
}

model EnrichmentRow {
  id String @id @default(uuid())
  batchId String
  batch EnrichmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber Int
  recordId String?
  recordLabel String?
  input Json
  changes Json
  original Json
  status String @default("READY")
  error String?
  appliedAt DateTime?
  updatedAt DateTime @updatedAt

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
}

enum NextActionRepeat {
  NONE
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

enum NextActionState {
  OPEN
  DONE
  CANCELLED
}

/// A next action is something to do (ACTION: email, call, LinkedIn), or a meeting already booked
/// (MEETING), which is held or moved rather than called and stays out of calls-due counts (B183).
enum NextActionKind {
  ACTION
  MEETING
}

/// A person's next action outside any campaign (owner, 25 September 2026): what to do, on which
/// day, once or on repeat. It is worked in Tasks and kept in step with the person's Next Action and
/// Next Action Due Date in Twenty, both ways. One open next action per person, as Twenty has one.
model NextAction {
  id            String           @id @default(uuid())
  /// Null for a sandbox contact's next action, which never reaches Twenty until the contact moves.
  personId      String?
  person        PersonCache?     @relation(fields: [personId], references: [id], onDelete: Cascade)
  sandboxContactId String?
  sandboxContact   SandboxContact? @relation(fields: [sandboxContactId], references: [id], onDelete: Cascade)
  foUserId      String
  fo            User             @relation("NextActionFo", fields: [foUserId], references: [id])
  /// What to do, as it is written to Twenty's Next Action.
  label         String
  action        ActionType       @default(EMAIL)
  kind             NextActionKind    @default(ACTION)
  /// A MEETING's date and time, when known; `dueDate` holds its day either way.
  meetingAt        DateTime?
  /// LocalDate (YYYY-MM-DD): the day it is due, written to Twenty's Next Action Due Date.
  dueDate       String
  repeat        NextActionRepeat @default(NONE)
  state         NextActionState  @default(OPEN)
  createdById   String?
  completedById String?
  /// How many times a repeating one has been done.
  doneCount     Int              @default(0)
  lastDoneAt    DateTime?
  closedAt      DateTime?
  /// True while Cadence's value has not reached Twenty yet; the worker keeps trying.
  crmPending    Boolean          @default(true)
  /// When Twenty last matched this next action, by Cadence's write or by following Twenty.
  crmSyncedAt   DateTime?
  crmError      String?
  /// N28: failed sends in a row, and when the worker may send it again (backs off, then gives up).
  crmAttempts   Int              @default(0)
  crmRetryAt    DateTime?
  /// CRM or cold outreach (SANDBOX), set once when the row is created and never changed (PLAN 8.4,
  /// B037). A move closes the cold row and opens a CRM one; it never restamps. Null only on rows
  /// written before the stamping code; NOT NULL in W14.
  audience         CampaignAudience?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Two partial unique indexes live in the migrations, as Prisma cannot declare them:
  // NextAction_one_open_per_person (personId) WHERE state = 'OPEN', and
  // NextAction_one_open_per_sandbox_contact (sandboxContactId) WHERE state = 'OPEN' AND personId IS NULL.
  @@index([audience, dueDate])
  @@index([foUserId, state, dueDate])
  @@index([personId, state])
  @@index([sandboxContactId, state])
  @@index([state, crmPending])
}

// ---------------------------------------------------------------------------
// Outreach sandbox: contacts that are not in Twenty yet (docs/outreach-sandbox-plan.md)
// ---------------------------------------------------------------------------

enum SandboxStatus {
  /// Workable in the sandbox.
  ACTIVE
  /// In Twenty now; the row is a tombstone (its data is kept for the one-year undo window).
  MOVED
  /// Asked not to be contacted.
  OPTED_OUT
  /// Removed by a user or by retention; personal data cleared.
  REMOVED
}

enum ContactSource {
  BELLWETHER
  MANUAL
  CSV
  CALL
  /// Someone a teammate reached on LinkedIn who was in neither the CRM nor Cold outreach.
  LINKEDIN
}

/// A contact that is not in Twenty. The firm is flat on the row: the sandbox works people, and the
/// firm only matters again when the contact moves to Twenty.
model SandboxContact {
  id                  String        @id @default(uuid())
  status              SandboxStatus @default(ACTIVE)
  source              ContactSource
  firstName           String
  lastName            String
  sortName            String?
  jobTitle            String?
  /// Lower-cased.
  email               String?
  /// The email is a shared inbox (info@, sales@, compliance@...; normalize.ts isRoleEmail), which
  /// different people really do share: left out of the one-live-contact-per-email rule (B177, N025).
  emailIsRole         Boolean       @default(false)
  /// valid | risky | unknown
  emailVerification   String?
  additionalEmails    String[]      @default([])
  /// E.164.
  phone               String?
  /// direct | mobile | office | main | toll_free | unknown
  phoneType           String?
  phoneExtension      String?
  /// [{ number: E.164, type }]
  additionalPhones    Json          @default("[]")
  /// linkedin.com/in/<slug>
  linkedinUrl         String?
  city                String?
  state               String?
  /// ISO 3166-1 alpha-2.
  country             String?
  individualCrd       String?
  designations        String[]      @default([])
  /// Twenty productInterest values.
  productInterest     String[]      @default([])
  tags                String[]      @default([])
  companyName         String?
  companyDomain       String?
  companyWebsite      String?
  companyCrd          String?
  companyCity         String?
  companyState        String?
  companyCountry      String?
  companyPhone        String?
  companyAumUsd       Decimal?      @db.Decimal(24, 2)
  companyEmployees    Int?
  ownerId             String?
  owner               User?         @relation("SandboxOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  podId               String?
  pod                 Pod?          @relation(fields: [podId], references: [id], onDelete: SetNull)
  claimedAt           DateTime?
  /// The first time someone took the contact on (a claim, or an assignment by a leader). Unlike
  /// `claimedAt`, a push with an owner does not set it, so the funnel counts real claims (B194).
  firstClaimedAt      DateTime?
  /// The Bellwether record this contact came from; null for contacts added in Cadence.
  bellwetherContactId String?       @unique
  /// More Bellwether records that were pushed for the same person and matched this contact.
  bellwetherAliases   String[]      @default([])
  bellwetherUrl       String?
  sourceNote          String?
  /// LocalDate the source collected it.
  collectedAt         String?
  pushedByEmail       String?
  /// The pusher's name as Cadence knows them, shown instead of the email (B205).
  pushedByName        String?
  createdById         String?
  badEmail            Boolean       @default(false)
  badPhone            Boolean       @default(false)
  /// Set when an email to the contact may have bounced but the notice did not say so for certain
  /// (a subject-only match): a "Possible bounce" badge with Clear / Confirm, never sent to Twenty (N097).
  possibleBounceAt    DateTime?
  optedOutAt          DateTime?
  optOutReason        String?
  /// Where the opt-out came from (src/lib/sandbox/opt-out.ts OptOutSource). Only one from the
  /// post-call form (call_form) may be lifted, by an admin or by Biz Ops closing a ticket (D4).
  optOutSource        String?
  /// When an opt-out was last lifted (D4); Bellwether reads it as `optOutLiftedAt` (contract 1.1).
  optOutLiftedAt      DateTime?
  /// Who removed the contact and why (asked in the Remove dialog; B086). Retention leaves both null.
  removedById         String?
  removedReason       String?
  /// The latest post-call outcome and when it was filed: "Ready to move" and "Closed" read it (D3).
  lastOutcome         String?
  lastOutcomeAt       DateTime?
  /// A CRM person Bellwether's push or the nightly check thought might be this contact, not
  /// certain enough to stop outreach: "Possibly in the CRM: Jane Doe" (B143).
  possibleCrmPersonId String?
  /// An active cold contact Bellwether's push thought might be the same person: the same firm and
  /// last name, or a shared office line. Never a refusal: "Possibly the same as Jane Doe" (B017).
  possibleDuplicateId String?
  /// When an admin erased the contact (N039); Bellwether reads it as `erasedAt` and blanks the person.
  erasedAt            DateTime?
  /// legitimate_interest | consent; set for EEA/UK contacts.
  lawfulBasis         String?
  /// Last call, email, note or task: drives retention.
  lastActivityAt      DateTime?
  /// When the status Bellwether reads last changed: every opt-out, move, undo, removal, owner change,
  /// call outcome and bounce sets it in the same write, from the database clock (B061, B062).
  statusChangedAt     DateTime      @default(now())
  movedAt             DateTime?
  movedById           String?
  twentyPersonId      String?       @unique
  twentyCompanyId     String?
  /// A Twenty person that Twenty's own mail or calendar sync created for this contact, which
  /// someone has since worked in the CRM, so the cleanup left it (src/lib/sandbox/crm-cleanup.ts).
  crmAutoPersonId     String?
  /// EMAIL | CALENDAR: what created that person.
  crmAutoSource       String?
  crmAutoFlaggedAt    DateTime?
  /// The Twenty person the daily check found for this contact after the push: its outreach was
  /// stopped and Bellwether reads it as already_in_crm (src/lib/sandbox/crm-check.ts).
  crmMatchPersonId    String?
  /// email | linkedin_url | phone
  crmMatchedOn        String?
  crmMatchedAt        DateTime?
  piiClearedAt        DateTime?
  /// The contact's keys as the suppression list keeps them ([{ kind, valueHash, label, subjectId }]),
  /// saved when Remove or retention clears its details, so the tombstone can still be opted out or
  /// erased (N027). Hashes only, never the values.
  keptKeys            Json          @default("[]")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  enrollments Enrollment[]
  nextActions NextAction[]
  touches     Touch[]
  calls       CallLog[]
  notes       SandboxNote[]
  emails      SandboxEmail[]
  tickets     Ticket[]
  linkedinFollowUps LinkedInFollowUp[]

  // CHECK SandboxContact_owner_has_pod ("ownerId" IS NULL OR "podId" IS NOT NULL) lives in the
  // migrations (B050, M2): an owned contact always has a pod. NOT VALID until W14 validates it.

  @@index([status, ownerId])
  @@index([status, podId])
  @@index([status, lastActivityAt])
  @@index([statusChangedAt])
  @@index([email])
  @@index([phone])
  @@index([linkedinUrl])
  @@index([individualCrd])
  @@index([companyDomain])
  @@index([sortName])
  /// An email to a removed contact is recognised by the hashes it keeps (N016, N027).
  @@index([keptKeys(ops: JsonbPathOps)], type: Gin)
}

model SandboxNote {
  id               String         @id @default(uuid())
  sandboxContactId String
  contact          SandboxContact @relation(fields: [sandboxContactId], references: [id], onDelete: Cascade)
  authorId         String?
  authorName       String?
  body             String
  /// Set when the contact moves.
  twentyNoteId     String?
  createdAt        DateTime       @default(now())

  @@index([sandboxContactId, createdAt])
}

/// Never contact again. Values are SHA-256 of the normalised value, so an erased contact leaves no
/// readable personal data behind and a later push of the same person is still refused.
model Suppression {
  id               String   @id @default(uuid())
  /// email | phone | linkedin | bellwether_id | individual_crd: the person, wherever they turn up.
  /// phone_subject: a firm main, office or unknown line, which blocks only the one person in
  /// `subjectId` and warns for colleagues on it, so a shared line never opts a colleague out (PLAN 8.2).
  kind             String
  valueHash        String
  /// What an admin typed, masked (j***@acme.com), so the list is legible without keeping the value.
  label            String?
  /// opted_out | erased | do_not_contact
  reason           String
  /// The one person a phone_subject row protects: the cold contact's id or the CRM person's id.
  /// Null for every other kind, which protects whoever holds the value.
  subjectId        String?
  /// The opt-out that wrote it (OptOutSource: call_form, contact_page, suppression_list, erase...).
  /// Lifting a form opt-out (D4) removes only the rows its own opt-out wrote.
  source           String?
  sandboxContactId String?
  personId         String?
  createdById      String?
  createdAt        DateTime @default(now())

  // One row per value: two partial unique indexes live in the migrations, as Prisma cannot declare
  // them: Suppression_global_key (kind, valueHash) WHERE subjectId IS NULL, and
  // Suppression_subject_key (kind, valueHash, subjectId) WHERE subjectId IS NOT NULL. Insert with
  // createMany({ skipDuplicates: true }), which respects both.
  @@index([valueHash])
  @@index([subjectId])
  @@index([sandboxContactId])
  @@index([personId])
  @@index([createdAt])
}

enum CallDirection {
  OUTBOUND
  INBOUND
}

enum CallStatus {
  QUEUED
  INITIATED
  RINGING
  IN_PROGRESS
  COMPLETED
  BUSY
  NO_ANSWER
  FAILED
  CANCELED
}

enum CallSource {
  TWILIO_IMPORT
  MANUAL
}

/// Every call, sandbox or CRM: read from Twilio's REST API (calls placed through the hosted dialpad
/// or any other app on the account), or logged by hand. Cadence places no calls itself. One row per
/// conversation: the Twilio leg that reaches the phone network.
model CallLog {
  id               String          @id @default(uuid())
  source           CallSource
  direction        CallDirection
  /// The leg to or from the phone network.
  twilioCallSid    String?         @unique
  /// The dialpad's browser leg, when there is one.
  parentCallSid    String?
  fromNumber       String?
  toNumber         String?
  /// client:<identity> seen on the call or its parent, e.g. tw_alyssa.
  repIdentity      String?
  status           CallStatus      @default(QUEUED)
  /// Imports overlap; the status never moves back.
  statusRank       Int             @default(0)
  twilioStatus     String?
  startedAt        DateTime?
  endedAt          DateTime?
  /// Twilio's duration; 0 when nobody answered.
  talkSec          Int?
  priceUsd         Decimal?        @db.Decimal(10, 4)
  userId           String?
  user             User?           @relation("CallUser", fields: [userId], references: [id], onDelete: SetNull)
  /// The pod the call counts for, at the time of the call: the enrollment's, else the contact's,
  /// else the rep's only pod. Reports filter calls by it, never by today's pods (B040).
  podId            String?
  pod              Pod?              @relation(fields: [podId], references: [id], onDelete: SetNull)
  /// caller_number | alias | intent | chosen | manual | none
  repMatchedBy     String?
  personId         String?
  person           PersonCache?    @relation(fields: [personId], references: [id], onDelete: SetNull)
  sandboxContactId String?
  sandboxContact   SandboxContact? @relation(fields: [sandboxContactId], references: [id], onDelete: SetNull)
  /// dialed | number | chosen | ambiguous | none
  matchedBy        String?
  /// The possible contacts of an ambiguous call: [{ kind, id, name }].
  candidates       Json?
  taskId           String?
  nextActionId     String?
  enrollmentId     String?
  campaignId       String?
  touchId          String?         @unique
  /// Twilio's recording; played through the proxy route, never copied.
  recordingSid     String?
  recordingSec     Int?
  recordingCount   Int             @default(0)
  /// Null while the import still looks for the recording (48 hours after the call), then found or
  /// not_found, so the call page can say so (N050).
  recordingStatus  String?
  /// Set when a matched rep's call has ended: the post-call form is due from then.
  formDueAt        DateTime?
  formDoneAt       DateTime?
  /// Who fills the form when it is not the rep who made the call (N010): the replacement after the
  /// rep's access was removed, or a colleague a leader handed it to. Null: the rep who made it. The
  /// call keeps its rep, so figures by rep never change.
  formUserId       String?
  /// A call logged by mistake, discarded by the rep soon after: kept for the audit, out of every
  /// count and form queue (B024).
  discardedAt      DateTime?
  discardReason    String?
  /// CRM or cold outreach (SANDBOX), stamped once when the call is matched to someone and never
  /// changed (PLAN 8.4, B037). An unmatched call stays null, so All = CRM + Cold + Not matched yet.
  audience         CampaignAudience?
  importedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  form CallForm?

  @@index([audience, startedAt])
  @@index([podId, startedAt])
  @@index([userId, startedAt])
  @@index([userId, formDoneAt])
  @@index([formUserId, formDoneAt])
  @@index([personId, startedAt])
  @@index([sandboxContactId, startedAt])
  @@index([campaignId, startedAt])
  @@index([startedAt])
  @@index([toNumber])
  @@index([fromNumber])
  @@index([parentCallSid])
  @@index([status, startedAt])
}

/// A press of Cadence's Call button: who, which number, for which task or contact. The dialpad
/// knows none of this, so the import links the Twilio call to the newest intent by the same rep to
/// the same number within 30 minutes before the call started.
model CallIntent {
  id               String   @id @default(uuid())
  userId           String
  /// E.164.
  toNumber         String
  personId         String?
  sandboxContactId String?
  taskId           String?
  nextActionId     String?
  /// Set once a call has claimed it.
  callId           String?  @unique
  createdAt        DateTime @default(now())

  @@index([userId, toNumber, createdAt])
  @@index([toNumber, createdAt])
}

model CallForm {
  id                String   @id @default(uuid())
  callId            String   @unique
  call              CallLog  @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId            String
  /// Key in settings.rules.callDispositions.
  outcome           String
  /// 1-5, required when the outcome is answered.
  rating            Int?
  /// Required when the outcome is answered.
  notes             String?
  /// The next step together with its date: one field in the form, two columns here.
  /// call_again | email | linkedin | meeting | none
  nextStep          String
  /// LocalDate; required for every next step except none.
  nextStepDate      String?
  /// hot | warm | cold
  interest          String?
  productsDiscussed String[] @default([])
  /// yes | no | unknown
  decisionMaker     String?
  nextActionId      String?
  /// The next step's "What" (N043), as its next action reads.
  nextStepLabel     String?
  /// What leaders look at (B025, B029): long_voicemail | no_conversation | called_opted_out.
  flags             String[] @default([])
  /// CRM contact: at once. Sandbox contact: when moved.
  twentyNoteId      String?
  /// The call's audience when the form was filed, never changed (PLAN 8.4, B037).
  audience          CampaignAudience?
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([audience, submittedAt])
}

enum SandboxEmailKind {
  SENT
  REPLY
  AUTO_REPLY
  BOUNCE
}

/// Mail seen in a sales mailbox to or from a sandbox contact. Nothing else is stored.
model SandboxEmail {
  id                String           @id @default(uuid())
  sandboxContactId  String
  contact           SandboxContact   @relation(fields: [sandboxContactId], references: [id], onDelete: Cascade)
  /// Whose mailbox.
  userId            String?
  kind              SandboxEmailKind
  internetMessageId String
  conversationId    String?
  subject           String?
  at                DateTime
  /// The step it closed.
  taskId            String?
  touchId           String?
  createdAt         DateTime         @default(now())

  @@unique([internetMessageId, sandboxContactId])
  @@index([sandboxContactId, at])
  @@index([conversationId])
}

/// Where Outlook tracking is in one folder of one sales mailbox (src/lib/mail/graph-mail.ts).
model MailboxCursor {
  userId        String
  /// sentitems | inbox
  folder        String
  /// Microsoft's delta link: the folder is in step and the next run reads only what changed.
  deltaLink     String?
  /// The page a first sync (or a restart) has reached, kept between runs so a big mailbox gets
  /// there in the end instead of starting again every run (N015).
  nextLink      String?
  /// Mail from this moment on is read: when tracking first ran for this folder.
  startedAt     DateTime?
  /// Last tried, whatever happened.
  lastRunAt     DateTime?
  /// Last run that read the folder without an error.
  lastSuccessAt DateTime?
  /// The last run's error, cleared by the next good run, and since when it has failed.
  error         String?
  errorAt       DateTime?
  /// When Microsoft last said the sync link had expired and the folder was read again from a date.
  resetAt       DateTime?

  @@id([userId, folder])
}

/// One push request from Bellwether, kept 7 days for idempotent replay. Check requests write
/// nothing and have no row.
model BellwetherPush {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  bodyHash       String
  /// PROCESSING | DONE
  state          String
  pushedByEmail  String
  ownerId        String?
  /// The pod the push is for: its owner's pod, else the pod Bellwether named. Leaders see the pushes
  /// of their pods (From Bellwether). Null on pushes from before it was kept: the pusher's pods decide.
  podId          String?
  contactCount   Int
  response       Json?
  createdAt      DateTime @default(now())

  items BellwetherPushItem[]

  @@index([createdAt])
  @@index([podId, createdAt])
}

/// Per-contact result of a push, kept as long as the contact's status may be asked for.
model BellwetherPushItem {
  id                  String         @id @default(uuid())
  pushId              String
  push                BellwetherPush @relation(fields: [pushId], references: [id], onDelete: Cascade)
  bellwetherContactId String
  result              String
  reason              String?
  sandboxContactId    String?
  crmPersonId         String?
  createdAt           DateTime       @default(now())

  @@index([bellwetherContactId, createdAt])
}

/// A pushed Bellwether contact that did not become a sandbox contact but still has a status
/// Bellwether reads: already in the CRM, or refused as suppressed (opted out).
model BellwetherRefusal {
  bellwetherContactId String   @id
  /// already_in_crm | opted_out | refused (contract 1.1: any other refusal, with its reason; B015)
  status              String
  /// The push's rejected reason for a refused one (invalid_field, do_not_contact, blocked_account,
  /// internal_contact, duplicate_in_request). Contract 1.1 reports it; v1 never sees a refused one.
  reason              String?
  crmPersonId         String?
  /// The key the refusal matched on: email | linkedin | phone_personal (direct or mobile) |
  /// phone_shared (office, main, unknown) | bellwether_id | individual_crd | name_firm. Opting a CRM
  /// person out flips only refusals that matched on their own details, never a shared line (N011).
  /// Null on refusals from before it was kept.
  matchedOn           String?
  statusChangedAt     DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([statusChangedAt])
}

/// One Move to CRM: up to 50 contacts. Each item can be undone for one year.
model SandboxMove {
  id          String    @id @default(uuid())
  createdById String
  count       Int
  /// QUEUED | RUNNING | DONE
  state       String
  /// What the queue left out and why, for the move's own page (B186): [{ contactId, name, reason }].
  leftOut     Json      @default("[]")
  /// The step the dialog gave for contacts without one of their own ({ label, action, dueDate }).
  nextStep    Json?
  /// When the mover was told the move ended (B036).
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  items SandboxMoveItem[]

  @@index([createdAt])
}

model SandboxMoveItem {
  id               String      @id @default(uuid())
  moveId           String
  move             SandboxMove @relation(fields: [moveId], references: [id], onDelete: Cascade)
  sandboxContactId String
  /// QUEUED | RUNNING | DONE | FAILED | DRY_RUN | UNDOING | UNDONE | UNDO_PARTIAL. At most one item
  /// per contact is QUEUED or RUNNING: SandboxMoveItem_one_in_flight_per_contact, a partial unique
  /// index in the migrations (B005).
  state            String
  /// transient (Retry may work) | permanent (it will not: opted out, removed, already in the CRM).
  /// Null on failures from before it was kept, which count as transient.
  failure             String?
  /// When a process took the item (RUNNING). The web request and the worker both work the queue;
  /// the claim keeps them off the same item, and a stale claim is taken back.
  claimedAt        DateTime?
  /// create | attach
  mode             String
  /// The Twenty person to attach to (attach mode).
  attachPersonId   String?
  /// The Twenty company chosen in the dialog, when the firm matched several.
  chosenCompanyId  String?
  /// linked | created | none
  companyAction    String?
  twentyPersonId   String?
  twentyCompanyId  String?
  /// Twenty note ids, for undo.
  notesWritten     String[]    @default([])
  /// Twenty's updatedAt after Cadence's last write, for undo.
  personUpdatedAt  String?
  /// The contact as it was moved.
  snapshot         Json
  /// The step chosen in the dialog ({ label, action, dueDate }): applied only when the item succeeds,
  /// so nothing on the contact changes at queue time (B034).
  nextStep            Json?
  /// The contact's own open next step when the move was queued, restored by Undo or a failure.
  priorNextAction     Json?
  /// The CRM person's Next Action before an attach wrote one ({ nextAction, dueDate }), for Undo (B097).
  personNextBefore    Json?
  /// Enrollments the move ended, so Undo can offer "Put back in <campaign>" (B101).
  exitedEnrollmentIds String[]    @default([])
  /// What Undo did and did not manage: { personDeleted, notesDeleted, notesLeft, companyDeleted } (B113).
  undoReport          Json?
  /// The last moment this item can be undone, fixed when it is made: lowering the setting later does
  /// not take undo away from moves already made (N062).
  undoUntil           DateTime?
  error            String?
  attempts         Int         @default(0)
  doneAt           DateTime?
  undoneAt         DateTime?
  undoneById       String?

  @@index([moveId])
  @@index([sandboxContactId])
  @@index([state])
}

// ---------------------------------------------------------------------------
// Tickets and notifications
// ---------------------------------------------------------------------------

/// What a ticket is about. MEETING_NUMBER is the meeting-number check, which today still lives in
/// MeetingNumberTicket and can be folded in here.
enum TicketKind {
  /// "Think this is wrong?" on an opt-out from the post-call form (D4).
  OPT_OUT
  MEETING_NUMBER
}

/// A question someone raises for Biz Ops, who look into it and close it with a note (D4, owner, 5
/// November 2026). Built like MeetingNumberTicket (src/lib/actions/number-checks.ts): Biz Ops' Tickets
/// section lists every open ticket of either table. Closing an OPT_OUT ticket may lift the opt-out.
model Ticket {
  id               String          @id @default(uuid())
  kind             TicketKind
  /// Who it is about: a CRM person, a cold contact, or both once the contact has moved.
  personId         String?
  person           PersonCache?    @relation(fields: [personId], references: [id], onDelete: SetNull)
  sandboxContactId String?
  sandboxContact   SandboxContact? @relation(fields: [sandboxContactId], references: [id], onDelete: SetNull)
  /// The meeting it was raised on (MEETING_NUMBER).
  meetingId        String?
  meeting          Meeting?        @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  /// What the person raising it says.
  note             String?
  /// What Cadence showed when it was raised, by kind. OPT_OUT: { optedOutAt, source, reason, callId }.
  /// MEETING_NUMBER: { meetingDay, shownNumber, expectedNumber }.
  details          Json?
  open             Boolean         @default(true)
  raisedById       String?
  raisedBy         User?           @relation("TicketRaisedBy", fields: [raisedById], references: [id], onDelete: SetNull)
  resolvedById     String?
  resolvedBy       User?           @relation("TicketResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  /// The note it was closed with, for whoever raised it.
  resolution       String?
  /// What closing it did. OPT_OUT: lifted | kept. MEETING_NUMBER: number_set | unchanged.
  outcome          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([open, createdAt])
  @@index([kind, open])
  @@index([personId])
  @@index([sandboxContactId])
}

/// Something one user is told about that is not a reply (replies stay touches): a colleague's
/// suggested next step after a call, accepted only through the same checks as any next step (B027);
/// mail seen to an opted-out or removed contact (N016); a bounce (N064).
model Notification {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation("NotificationFor", fields: [userId], references: [id], onDelete: Cascade)
  /// next_step_suggestion | compliance_alert | bounce
  kind             String
  personId         String?
  sandboxContactId String?
  /// Who it came from, when a person: the colleague who filed the call.
  fromUserId       String?
  /// What it says and, for a suggestion, what accepting it would set: { what, how, when, callId }.
  payload          Json
  readAt           DateTime?
  /// accepted | dismissed, and when.
  resolution       String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// A key an admin made in Settings > API keys for a script or tool to read Cadence through /api/v1
/// (read only). Only the SHA-256 of the whole key is kept; the key itself is shown once.
model ApiKey {
  /// The 8 characters after `cad_` in the key: how a request finds its row.
  id            String          @id
  name          String
  keyHash       String
  /// team | crm | campaigns | tasks | activity | cold-outreach | reports
  scopes        String[]
  /// Exact IPs or CIDRs; empty means any address.
  allowedIps    String[]
  /// Null only when the admin chose "never expires".
  expiresAt     DateTime?
  createdById   String?
  createdByName String?
  createdAt     DateTime        @default(now())
  lastUsedAt    DateTime?
  lastUsedIp    String?
  revokedAt     DateTime?
  revokedByName String?
  requests      ApiRequestLog[]
}

/// One request a key made, kept 90 days (the nightly job prunes it).
model ApiRequestLog {
  id        String   @id @default(uuid())
  keyId     String
  key       ApiKey   @relation(fields: [keyId], references: [id], onDelete: Cascade)
  method    String
  path      String
  status    Int
  rows      Int?
  ip        String?
  ms        Int
  createdAt DateTime @default(now())

  @@index([keyId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// LinkedIn, observed through the LinkedIn Console (Notes/linkedin-2026-11-12/PLAN.md). Cadence never
// acts on LinkedIn: teammates act by hand in the Console, and the Console reports what it saw.
// ---------------------------------------------------------------------------

/// A LinkedIn account connected to the Console. Not a rep: several teammates often work one account.
model LinkedInAccount {
  /// The Console's account id.
  id                String   @id
  name              String
  /// Connection requests sent from the account in the last 7 days, as the Console last counted them.
  invitesLast7Days  Int      @default(0)
  /// The account's own weekly limit from the Console; null = Settings > LinkedIn's.
  inviteWeeklyLimit Int?
  seenAt            DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// One event from the Console (webhook or feed), kept once by the Console's sequence number.
model LinkedInEvent {
  id               String    @id @default(uuid())
  seq              BigInt    @unique
  /// invitation.sent | invitation.withdrawn | connection.accepted | message.sent | message.received
  type             String
  at               DateTime
  accountId        String?
  /// The teammate the Console names (work email), and the Cadence user it matched.
  userEmail        String?
  userId           String?
  memberUrn        String?
  /// linkedin.com/in/<slug>; null while the Console does not know the person's profile link yet.
  profileKey       String?
  name             String?
  payload          Json
  /// webhook | feed | test
  via              String
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  result           String?
  personId         String?
  sandboxContactId String?

  @@index([processedAt])
  @@index([profileKey])
  @@index([memberUrn])
  @@index([result])
  @@index([at])
}

enum LinkedInLinkStatus {
  /// A connection request is waiting.
  PENDING
  ACCEPTED
  WITHDRAWN
}

/// Where one firm account stands with one person on LinkedIn.
model LinkedInLink {
  id               String             @id @default(uuid())
  accountId        String
  profileKey       String
  memberUrn        String?
  name             String?
  personId         String?
  sandboxContactId String?
  status           LinkedInLinkStatus
  /// False when they asked us to connect (or the Console cannot tell); only our own requests count.
  invitedByUs      Boolean            @default(true)
  invitedAt        DateTime?
  invitedByUserId  String?
  acceptedAt       DateTime?
  withdrawnAt      DateTime?
  /// Requests sent again after a withdrawal. The owner's rule: one resend, then stop.
  resends          Int                @default(0)
  lastSentAt       DateTime?
  lastReplyAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  followUps LinkedInFollowUp[]

  @@unique([accountId, profileKey])
  @@index([personId])
  @@index([sandboxContactId])
  @@index([profileKey])
  @@index([status, invitedAt])
}

enum LinkedInFollowUpKind {
  /// They accepted our request: message them.
  MESSAGE
  /// The request has waited too long: withdraw it.
  WITHDRAW
  /// The request was withdrawn: send it again after LinkedIn's cool-off.
  RESEND
  /// They answered an email (not an auto-reply), in a campaign or not: answer them (owner, 13 Nov 2026).
  EMAIL_REPLY
}

enum LinkedInFollowUpState {
  OPEN
  DONE
  CANCELLED
}

/// A task Cadence made from what it saw, outside any campaign: LinkedIn ones from the Console, and
/// "Reply to their email" from an email reply. No FO yet = Needs an owner.
model LinkedInFollowUp {
  id               String                @id @default(uuid())
  kind             LinkedInFollowUpKind
  state            LinkedInFollowUpState @default(OPEN)
  /// Null for an email reply.
  linkId           String?
  link             LinkedInLink?         @relation(fields: [linkId], references: [id], onDelete: Cascade)
  /// The firm LinkedIn account to act from; null for an email reply.
  accountId        String?
  personId         String?
  person           PersonCache?          @relation(fields: [personId], references: [id], onDelete: Cascade)
  sandboxContactId String?
  sandboxContact   SandboxContact?       @relation(fields: [sandboxContactId], references: [id], onDelete: Cascade)
  foUserId         String?
  fo               User?                 @relation("LinkedInFollowUpFo", fields: [foUserId], references: [id], onDelete: SetNull)
  /// What started it: accepted | replied | pending | withdrawn | email_reply.
  trigger          String
  /// When that happened.
  triggeredAt      DateTime
  /// LocalDate. Null while nobody owns it: the clock starts when someone does.
  dueDate          String?
  assignedAt       DateTime?
  completedAt      DateTime?
  completedById    String?
  completionSource CompletionSource?
  /// What closed it: linkedin:<seq>, or the email seen going to them.
  evidenceId       String?
  /// What opened it, for an email reply: the reply's touch (so one reply opens one task).
  sourceId         String?           @unique
  closeReason      String?
  audience         CampaignAudience?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  // One open follow-up of a kind per link: LinkedInFollowUp_one_open_per_link (linkId, kind) WHERE
  // state = 'OPEN', in the migration.
  @@index([foUserId, state, dueDate])
  @@index([state, foUserId])
  @@index([personId, state])
  @@index([sandboxContactId, state])
}
