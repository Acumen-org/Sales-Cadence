# ---------- Database ----------
# Local dev (Postgres on your machine or `docker compose up db`):
DATABASE_URL=postgresql://cadence:cadence@localhost:5433/cadence
# Inside docker compose the web/worker containers override this to point at the `db` service.

# ---------- App ----------
APP_URL=http://localhost:3100
# Long random string used to sign session cookies. Change it.
SESSION_SECRET=change-me-to-a-long-random-string
# Set true when Cadence is served over https.
COOKIE_SECURE=false
# Seed the default sequence, pods and demo users on start (idempotent).
SEED_ON_START=true
# Comma separated: which seed profiles to apply. "core" = default sequence + admin user.
# "demo" adds the dummy workspace (two pods, one user per role, twelve dummy people, campaigns with
# enrollments in every state) so you can click around. "demo-basic" = the same without campaigns.
# Remove both for production.
SEED_PROFILE=core,demo
# Admin account created by the seed (password is only set on first creation).
ADMIN_EMAIL=admin@cadence.local
ADMIN_PASSWORD=admin12345

# ---------- Twenty CRM ----------
# mock    = built-in fixtures (3 pods, 6 users, 40 people). No Twenty needed.
# graphql = talk to your Twenty server.
TWENTY_MODE=mock
# Base URL of your Twenty server, no trailing slash (the API lives at $TWENTY_API_URL/graphql).
TWENTY_API_URL=http://localhost:3000
# API key from Twenty > Settings > Developers > API keys.
TWENTY_API_KEY=
# Optional: secret configured on the Twenty webhook; when set, signatures are verified.
TWENTY_WEBHOOK_SECRET=
# Optional: shared token Cadence expects in the webhook URL (?token=...). Use if your Twenty cannot sign.
CADENCE_WEBHOOK_TOKEN=
# true = log what would be written to Twenty (notes, tasks) without writing.
CADENCE_DRY_RUN=false

# ---------- Worker ----------
# How often the worker runs the scheduler (generate due steps, roll caps, expire snoozes).
WORKER_TICK_SECONDS=300
# Hour (server local time, 0-23) for the nightly reconcile and cache refresh.
RECONCILE_HOUR=2

# ---------- Tests ----------
# If unset, `pnpm test` starts an embedded Postgres automatically.
# TEST_DATABASE_URL=postgresql://cadence:cadence@localhost:5433/cadence_test
