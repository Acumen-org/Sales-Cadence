# ---------- Database ----------
DATABASE_URL=postgresql://cadence:cadence@localhost:5433/cadence
# Inside docker compose the web/worker containers override this to point at the `db` service.

# ---------- App ----------
APP_URL=https://cadence.example.com
# Long random string used to sign session cookies. Change it before the first sign-in.
SESSION_SECRET=change-me-to-a-long-random-string
# true whenever Cadence is served over https, which it should be.
COOKIE_SECURE=true
# Apply migrations and the seed on start. The seed is idempotent, so leaving this on is safe.
SEED_ON_START=true
# What the seed creates. "core" is the default outbound sequence and the one admin account below,
# and nothing else: people, companies and pods all come from Twenty.
SEED_PROFILE=core
# The first and only account the seed creates. The password is set on creation and never again -
# change it from Settings after the first sign-in, then add the rest of the team there.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-me-before-first-run

# ---------- Twenty CRM ----------
# graphql = talk to your Twenty server. This is the only mode a real deployment uses.
TWENTY_MODE=graphql
# Base URL of your Twenty server, no trailing slash (the API lives at $TWENTY_API_URL/graphql).
TWENTY_API_URL=https://twenty.example.com
# API key from Twenty > Settings > Developers > API keys.
TWENTY_API_KEY=
# Secret configured on the Twenty webhook; when set, signatures are verified. Set one.
TWENTY_WEBHOOK_SECRET=
# Alternative for a Twenty that cannot sign: a shared token in the webhook URL (?token=...).
CADENCE_WEBHOOK_TOKEN=
# true = log what would be written to Twenty (notes, tasks) without writing. Worth leaving on for
# the first days of a pilot; see INTEGRATION.md.
CADENCE_DRY_RUN=false

# ---------- Worker ----------
# How often Cadence pulls changes from Twenty between webhooks.
CRM_SYNC_SECONDS=60
# How often the worker generates due steps, rolls caps and expires snoozes.
WORKER_TICK_SECONDS=300
# Hour (0-23, US Central) after which the daily catch-up reconcile and cache refresh run.
RECONCILE_HOUR=2

# ---------- Tests ----------
# `pnpm test` starts an embedded Postgres automatically; set this to use your own instead.
# TEST_DATABASE_URL=postgresql://cadence:cadence@localhost:5433/cadence_test
