# ---------- Database ----------
DATABASE_URL=postgresql://cadence:cadence@localhost:5433/cadence
# Inside docker compose the web/worker containers override this to point at the `db` service.

# ---------- App ----------
APP_URL=https://cadence.example.com
# true whenever Cadence is served over https, which it should be.
COOKIE_SECURE=true
# Apply migrations and the seed on start. The seed is idempotent, so leaving this on is safe.
SEED_ON_START=true
# What the seed creates. "core" is the default outbound sequence and the one admin account below,
# and nothing else: people, companies and pods all come from Twenty.
SEED_PROFILE=core
# The first and only account the seed creates. The password is set on creation and never again -
# change it from Settings after the first sign-in, then add the rest of the team there.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-me-before-first-run

# ---------- Twenty CRM ----------
# graphql = talk to your Twenty server. This is the only mode a real deployment uses.
# There is a second mode, `mock`, which serves a built-in fake CRM to the test suites and to
# `pnpm start:local`. It refuses to start unless CADENCE_ALLOW_MOCK=1 is also set, so a
# misconfigured deployment fails loudly instead of quietly running a sales team against
# invented contacts. Do not set either of them here.
TWENTY_MODE=graphql
# Base URL of your Twenty server, no trailing slash (the API lives at $TWENTY_API_URL/graphql).
TWENTY_API_URL=https://twenty.example.com
# API key from Twenty > Settings > Developers > API keys.
TWENTY_API_KEY=
# Secret configured on the Twenty webhook; when set, signatures are verified. Set one.
TWENTY_WEBHOOK_SECRET=
# Alternative for a Twenty that cannot sign: a shared token in the webhook URL (?token=...).
CADENCE_WEBHOOK_TOKEN=
# In production the webhook refuses events when neither of the two above is set. 1 overrides that.
# CADENCE_WEBHOOK_OPEN=1
# true = log what would be written to Twenty (notes, tasks) without writing. Worth leaving on for
# the first days of a pilot; see INTEGRATION.md.
CADENCE_DRY_RUN=false

# ---------- Sign-in ----------
# Microsoft sign-in. Usually saved by an admin under Settings > Sign-in; these override it. Register
# <APP_URL>/api/auth/microsoft/callback as a Web redirect URI on the app registration.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
# true brings password sign-in back after Microsoft took over (if Microsoft sign-in ever breaks).
PASSWORD_SIGN_IN=false

# ---------- Outreach sandbox (docs/outreach-sandbox-plan.md) ----------
# The key Bellwether sends in X-Cadence-Api-Key (the same value as Bellwether's CADENCE_API_KEY).
# Empty: the Bellwether endpoints answer 503 integration_disabled.
BELLWETHER_API_KEY=
# The previous key, only while a rotation is under way.
BELLWETHER_API_KEY_PREVIOUS=
# The read API (/api/v1) learns the caller's IP from X-Forwarded-For: how many proxies in front of
# Cadence append to it (1 behind one Caddy or nginx). 0: unknown, and keys with an IP allowlist are refused.
API_TRUSTED_PROXY_HOPS=0
# Twilio, read only: the account behind the hosted dialpad and a Restricted API key with read access
# to Calls, Recordings and IncomingPhoneNumbers. Empty: the call import is off.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# h00ks partner API key (Live, staff:read only): reps' Twilio numbers and dialpad identities are copied
# from h00ks before each call import. Empty: numbers are assigned by hand in Settings > Calling.
H00KS_API_TOKEN=
# true reads the sales mailboxes through Microsoft Graph (application Mail.Read, limited by an
# Exchange application access policy). Off until the admin steps in the plan are done.
GRAPH_MAIL_ENABLED=false

# ---------- Worker ----------
# How often Cadence pulls changes from Twenty between webhooks.
CRM_SYNC_SECONDS=60
# How often the worker generates due steps, rolls caps and expires snoozes.
WORKER_TICK_SECONDS=300
# Hour (0-23, US Central) after which the daily catch-up reconcile and cache refresh run.
RECONCILE_HOUR=2

# ---------- Tests ----------
# `pnpm test` starts an embedded Postgres automatically; set this to use your own instead.
# TEST_DATABASE_URL=postgresql://cadence:cadence@localhost:5433/cadence_test
